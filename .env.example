# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Flutter (dart-define — not .env)
# Pass at build time: flutter run --dart-define=SUPABASE_URL=...

# Python services
ANTHROPIC_API_KEY=your-key
POSTHOG_API_KEY=your-key
REVENUECAT_WEBHOOK_SECRET=your-secret

# RevenueCat
REVENUECAT_PUBLIC_KEY_IOS=your-key
REVENUECAT_PUBLIC_KEY_ANDROID=your-key

# AdMob
ADMOB_APP_ID_IOS=ca-app-pub-xxx
ADMOB_APP_ID_ANDROID=ca-app-pub-xxx
ADMOB_REWARDED_AD_UNIT_IOS=ca-app-pub-xxx
ADMOB_REWARDED_AD_UNIT_ANDROID=ca-app-pub-xxx
